[82.875, "o", "\u001b[90m 300\u001b[0m\u001b[90m │ \u001b[0m        topic = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mZ2M_PREFIX\u001b[33m}\u001b[39;49;00m\u001b[33m/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtopic_name\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[82.93, "o", "\u001b[90m 301\u001b[0m\u001b[90m │ \u001b[0m        mq.subscribe(topic)\u001b[90m\u001b[39;49;00m\n"]
[82.985, "o", "\u001b[90m 302\u001b[0m\u001b[90m │ \u001b[0m        mq.received.pop(topic, \u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[83.04, "o", "\u001b[90m 303\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# La SWV-NH es un end device a batería que duerme: solo publica al cambiar\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[83.095, "o", "\u001b[90m 304\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# su estado. Enviamos un \"get\" para forzar que responda con su estado actual.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[83.15, "o", "\u001b[90m 305\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[83.205, "o", "\u001b[90m 306\u001b[0m\u001b[90m │ \u001b[0m            mq.publish_json(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtopic\u001b[33m}\u001b[39;49;00m\u001b[33m/get\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, {\u001b[33m\"\u001b[39;49;00m\u001b[33mstate\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m})\u001b[90m\u001b[39;49;00m\n"]
[83.26, "o", "\u001b[90m 307\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mexcept\u001b[39;49;00m \u001b[96mConnectionError\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[83.315, "o", "\u001b[90m 308\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mpass\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[83.37, "o", "\u001b[90m 309\u001b[0m\u001b[90m │ \u001b[0m        payload = mq.wait_for(topic, \u001b[94mlambda\u001b[39;49;00m v: v \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m, timeout=\u001b[94m20\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[83.425, "o", "\u001b[90m 310\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m payload \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[83.48, "o", "\u001b[90m 311\u001b[0m\u001b[90m │ \u001b[0m            rows.append((alias, \u001b[33m\"\u001b[39;49;00m\u001b[33mNO DISPONIBLE\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) + (\u001b[33m\"\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,) * (\u001b[96mlen\u001b[39;49;00m(STATE_FIELDS) - \u001b[94m1\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[83.535, "o", "\u001b[90m 312\u001b[0m\u001b[90m │ \u001b[0m            any_missing = \u001b[94mTrue\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[83.59, "o", "\u001b[90m 313\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94melif\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(payload, \u001b[96mdict\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[83.645, "o", "\u001b[90m 314\u001b[0m\u001b[90m │ \u001b[0m            rows.append((alias,) + \u001b[96mtuple\u001b[39;49;00m(payload.get(key, \u001b[33m\"\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m) \u001b[94mfor\u001b[39;49;00m key, _ \u001b[95min\u001b[39;49;00m STATE_FIELDS))\u001b[90m\u001b[39;49;00m\n"]
[83.7, "o", "\u001b[90m 315\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[83.755, "o", "\u001b[90m 316\u001b[0m\u001b[90m │ \u001b[0m            rows.append((alias, \u001b[96mstr\u001b[39;49;00m(payload)) + (\u001b[33m\"\u001b[39;49;00m\u001b[33m-\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,) * (\u001b[96mlen\u001b[39;49;00m(STATE_FIELDS) - \u001b[94m1\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[83.81, "o", "\u001b[90m 317\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[83.865, "o", "\u001b[90m 318\u001b[0m\u001b[90m │ \u001b[0m    headers = [\u001b[33m\"\u001b[39;49;00m\u001b[33mVálvula\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m] + [label \u001b[94mfor\u001b[39;49;00m _, label \u001b[95min\u001b[39;49;00m STATE_FIELDS]\u001b[90m\u001b[39;49;00m\n"]
[83.92, "o", "\u001b[90m 319\u001b[0m\u001b[90m │ \u001b[0m    _print_table(rows, headers)\u001b[90m\u001b[39;49;00m\n"]
