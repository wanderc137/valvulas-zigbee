[27.825, "o", "\u001b[90m┌─ docker-compose.yml · Zigbee2MQTT ────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[27.825, "o", "\u001b[90m   1\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Despliegue de Zigbee2MQTT en Docker para control LOCAL/OFFLINE de válvulas Zigbee.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[27.88, "o", "\u001b[90m   2\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Uso: docker compose up -d && docker compose logs -f\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[27.935, "o", "\u001b[90m   3\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[27.99, "o", "\u001b[90m   4\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Requisitos:\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.045, "o", "\u001b[90m   5\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   - Dongle Sonoff en /dev/ttyUSB0 (chip EFR32, adapter \"ember\")\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.1, "o", "\u001b[90m   6\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   - Broker Mosquitto local activo en localhost:1883 (allow_anonymous true)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.155, "o", "\u001b[90m   7\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m#   - Usuario del sistema en grupos dialout y docker\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[28.21, "o", "\u001b[90m   8\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[28.265, "o", "\u001b[90m   9\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mservices\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.32, "o", "\u001b[90m  10\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m  \u001b[39;49;00m\u001b[94mzigbee2mqtt\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.375, "o", "\u001b[90m  11\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mimage\u001b[39;49;00m:\u001b[90m \u001b[39;49;00mkoenkk/zigbee2mqtt:latest\u001b[90m\u001b[39;49;00m\n"]
[28.43, "o", "\u001b[90m  12\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mcontainer_name\u001b[39;49;00m:\u001b[90m \u001b[39;49;00mzigbee2mqtt\u001b[90m\u001b[39;49;00m\n"]
[28.485, "o", "\u001b[90m  13\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mrestart\u001b[39;49;00m:\u001b[90m \u001b[39;49;00munless-stopped\u001b[90m\u001b[39;49;00m\n"]
[28.54, "o", "\u001b[90m  14\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mnetwork_mode\u001b[39;49;00m:\u001b[90m \u001b[39;49;00mhost\u001b[90m\u001b[39;49;00m\n"]
[28.595, "o", "\u001b[90m  15\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mdevices\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.65, "o", "\u001b[90m  16\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m-\u001b[90m \u001b[39;49;00m/dev/ttyUSB0:/dev/ttyUSB0\u001b[90m\u001b[39;49;00m\n"]
[28.705, "o", "\u001b[90m  17\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94mvolumes\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.76, "o", "\u001b[90m  18\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m-\u001b[90m \u001b[39;49;00m./config:/app/data\u001b[90m\u001b[39;49;00m\n"]
[28.815, "o", "\u001b[90m  19\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[94menvironment\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[28.87, "o", "\u001b[90m  20\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m      \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mTZ=America/Santiago\u001b[90m\u001b[39;49;00m\n"]
