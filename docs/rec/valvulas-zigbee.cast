[97.531, "o", "\u001b[90m┌─ valvulas.py · cmd_set(), despertado previo ──────────────────────────────────────────────────────────\u001b[0m\n"]
[97.531, "o", "\u001b[90m 352\u001b[0m\u001b[90m │ \u001b[0m    mq.subscribe(state_topic)\u001b[90m\u001b[39;49;00m\n"]
[97.586, "o", "\u001b[90m 353\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Descartar valores previos retenidos para no confundir confirmaciones antiguas\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.641, "o", "\u001b[90m 354\u001b[0m\u001b[90m │ \u001b[0m    mq.received.pop(state_topic, \u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[97.696, "o", "\u001b[90m 355\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[97.751, "o", "\u001b[90m 356\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# La SWV-NH es un end device a batería que entra en sueño profundo tras un rato\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.806, "o", "\u001b[90m 357\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# de inactividad. Un \"set\" directo mientras duerme caduca (timeout ZCL 10 s).\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.861, "o", "\u001b[90m 358\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# La despertamos primero con un \"get\" (lectura) y esperamos su respuesta real.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[97.916, "o", "\u001b[90m 359\u001b[0m\u001b[90m │ \u001b[0m    wake_timeout = \u001b[96mmin\u001b[39;49;00m(\u001b[94m20\u001b[39;49;00m, \u001b[96mmax\u001b[39;49;00m(\u001b[94m10\u001b[39;49;00m, timeout))\u001b[90m\u001b[39;49;00m\n"]
