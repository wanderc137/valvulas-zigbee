[113.642, "o", "\u001b[90m 383\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mComprueba que la válvula esté encendida, dentro del rango y que el comando lleg…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.697, "o", "\u001b[90m 384\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33m(logs de Zigbee2MQTT: docker compose logs -f).\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, file=sys.stderr)\u001b[90m\u001b[39;49;00m\n"]
[113.752, "o", "\u001b[90m 385\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33mSi acabas de reiniciar la Raspberry, espera 2-5 min a que las válvulas\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, file=s\u001b[04m\u001b[91m…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[113.807, "o", "\u001b[90m 386\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mprint\u001b[39;49;00m(\u001b[33m\"\u001b[39;49;00m\u001b[33m(end devices a batería) hagan check-in y vuelve a intentar.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, file=sys.stderr)\u001b[90m\u001b[39;49;00m\n"]
[113.862, "o", "\u001b[90m 387\u001b[0m\u001b[90m │ \u001b[0m        mq.disconnect()\u001b[90m\u001b[39;49;00m\n"]
