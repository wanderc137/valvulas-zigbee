[41.541, "o", "\u001b[90m┌─ valvulas.py · configuración local ───────────────────────────────────────────────────────────────────\u001b[0m\n"]
[41.541, "o", "\u001b[90m  41\u001b[0m\u001b[90m │ \u001b[0mMQTT_HOST = \u001b[33m\"\u001b[39;49;00m\u001b[33m127.0.0.1\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m          \u001b[90m# Broker Mosquitto local\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[41.596, "o", "\u001b[90m  42\u001b[0m\u001b[90m │ \u001b[0mMQTT_PORT = \u001b[94m1883\u001b[39;49;00m                 \u001b[90m# Puerto estándar MQTT\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[41.651, "o", "\u001b[90m  43\u001b[0m\u001b[90m │ \u001b[0mMQTT_USER = \u001b[94mNone\u001b[39;49;00m                 \u001b[90m# Sin credenciales (allow_anonymous true)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[41.706, "o", "\u001b[90m  44\u001b[0m\u001b[90m │ \u001b[0mMQTT_PASS = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[41.761, "o", "\u001b[90m  45\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[41.816, "o", "\u001b[90m  46\u001b[0m\u001b[90m │ \u001b[0mZ2M_PREFIX = \u001b[33m\"\u001b[39;49;00m\u001b[33mzigbee2mqtt\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m       \u001b[90m# base_topic de Zigbee2MQTT\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[41.871, "o", "\u001b[90m  47\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[41.926, "o", "\u001b[90m  48\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Alias -> nombre MQTT de la válvula (tal como queda tras el emparejamiento).\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[41.981, "o", "\u001b[90m  49\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Si el usuario renombra los dispositivos en Zigbee2MQTT, ajustar aquí.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.036, "o", "\u001b[90m  50\u001b[0m\u001b[90m │ \u001b[0mVALVULAS = {\u001b[90m\u001b[39;49;00m\n"]
[42.091, "o", "\u001b[90m  51\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mvalvula_riego\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mvalvula_riego\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[42.146, "o", "\u001b[90m  52\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33mvalvula_principal\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33mvalvula_principal\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[42.201, "o", "\u001b[90m  53\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
[42.256, "o", "\u001b[90m  54\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[42.311, "o", "\u001b[90m  55\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Alias -> nombre MQTT de los interruptores ON/OFF alimentados a red (p. ej. SONOFF\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.366, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# ZBMINIL2). A diferencia de las válvulas, no exponen caudal/volumen/batería y no\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.421, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# duermen (alimentación de red), por lo que no necesitan el \"despertar\" previo.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.476, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0mINTERRUPTORES = {\u001b[90m\u001b[39;49;00m\n"]
[42.531, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\u001b[39;49;00m\u001b[33minterruptor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m\"\u001b[39;49;00m\u001b[33minterruptor\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[42.586, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m}\u001b[90m\u001b[39;49;00m\n"]
[42.641, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[42.696, "o", "\u001b[90m  62\u001b[0m\u001b[90m │ \u001b[0mTIMEOUT = \u001b[94m15\u001b[39;49;00m                     \u001b[90m# segundos a esperar confirmación real de la válvula\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.751, "o", "\u001b[90m  63\u001b[0m\u001b[90m │ \u001b[0mPAIR_DEFAULT = \u001b[94m60\u001b[39;49;00m                \u001b[90m# segundos de permit_join por defecto en `pair`\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.806, "o", "\u001b[90m  64\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[42.861, "o", "\u001b[90m  65\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# Campos de estado reales expuestos por la SONOFF SWV-NH (Zigbee2MQTT 2.x).\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.916, "o", "\u001b[90m  66\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m# state usa ON/OFF (ON=válvula abierta, OFF=válvula cerrada).\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[42.971, "o", "\u001b[90m  67\u001b[0m\u001b[90m │ \u001b[0mSTATE_FIELDS = [\u001b[90m\u001b[39;49;00m\n"]
[43.026, "o", "\u001b[90m  68\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mstate\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mEstado\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.081, "o", "\u001b[90m  69\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mflow\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mCaudal (m³/h)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.136, "o", "\u001b[90m  70\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mreal_time_irrigation_volume\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mVol. riego (L)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.191, "o", "\u001b[90m  71\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mreal_time_irrigation_duration\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mDur. riego (s)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.246, "o", "\u001b[90m  72\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mdaily_irrigation_volume\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mVol. diario (L)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.301, "o", "\u001b[90m  73\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mvalve_work_state\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mModo válvula\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.356, "o", "\u001b[90m  74\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mbattery\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mBatería (\u001b[39;49;00m\u001b[33m%\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.411, "o", "\u001b[90m  75\u001b[0m\u001b[90m │ \u001b[0m    (\u001b[33m\"\u001b[39;49;00m\u001b[33mlinkquality\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mSeñal\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m),\u001b[90m\u001b[39;49;00m\n"]
[43.466, "o", "\u001b[90m  76\u001b[0m\u001b[90m │ \u001b[0m]\u001b[90m\u001b[39;49;00m\n"]
