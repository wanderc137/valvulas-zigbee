[69.099, "o", "\u001b[90m┌─ valvulas.py · publish_json() y wait_for() ───────────────────────────────────────────────────────────\u001b[0m\n"]
[69.099, "o", "\u001b[90m 136\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mpublish_json\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, topic, payload):\u001b[90m\u001b[39;49;00m\n"]
[69.154, "o", "\u001b[90m 137\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[33m\"\"\"Publica un dict como JSON retenido=False (comando efímero).\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[69.209, "o", "\u001b[90m 138\u001b[0m\u001b[90m │ \u001b[0m        raw = json.dumps(payload).encode(\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[69.264, "o", "\u001b[90m 139\u001b[0m\u001b[90m │ \u001b[0m        info = \u001b[96mself\u001b[39;49;00m.client.publish(topic, raw, qos=\u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[69.319, "o", "\u001b[90m 140\u001b[0m\u001b[90m │ \u001b[0m        info.wait_for_publish(timeout=\u001b[96mself\u001b[39;49;00m.timeout)\u001b[90m\u001b[39;49;00m\n"]
[69.374, "o", "\u001b[90m 141\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m info.rc != mqtt.MQTT_ERR_SUCCESS:\u001b[90m\u001b[39;49;00m\n"]
[69.429, "o", "\u001b[90m 142\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mraise\u001b[39;49;00m \u001b[96mConnectionError\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mFallo al publicar en \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtopic\u001b[33m}\u001b[39;49;00m\u001b[33m (rc=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00minfo.rc\u001b[33m}\u001b[39;49;00m\u001b[33m)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[69.484, "o", "\u001b[90m 143\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[69.539, "o", "\u001b[90m 144\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msubscribe\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, topic):\u001b[90m\u001b[39;49;00m\n"]
[69.594, "o", "\u001b[90m 145\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mself\u001b[39;49;00m.client.subscribe(topic, qos=\u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[69.649, "o", "\u001b[90m 146\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[69.704, "o", "\u001b[90m 147\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mwait_for\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, topic, predicate, timeout=\u001b[94mNone\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[69.759, "o", "\u001b[90m 148\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[33m\"\"\"Espera hasta que el topic tenga un payload que cumpla predicate.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[69.814, "o", "\u001b[90m 149\u001b[0m\u001b[90m │ \u001b[0m        deadline = time.time() + (timeout \u001b[95mor\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.timeout)\u001b[90m\u001b[39;49;00m\n"]
[69.869, "o", "\u001b[90m 150\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mwhile\u001b[39;49;00m time.time() < deadline:\u001b[90m\u001b[39;49;00m\n"]
[69.924, "o", "\u001b[90m 151\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m topic \u001b[95min\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.received \u001b[95mand\u001b[39;49;00m predicate(\u001b[96mself\u001b[39;49;00m.received[topic]):\u001b[90m\u001b[39;49;00m\n"]
[69.979, "o", "\u001b[90m 152\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.received[topic]\u001b[90m\u001b[39;49;00m\n"]
[70.034, "o", "\u001b[90m 153\u001b[0m\u001b[90m │ \u001b[0m            time.sleep(\u001b[94m0.1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
