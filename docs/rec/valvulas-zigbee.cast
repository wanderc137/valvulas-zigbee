[127.589, "o", "\u001b[90m┌─ valvulas.py · _report_metrics() ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[127.589, "o", "\u001b[90m 202\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_report_metrics\u001b[39;49;00m(payload, title=\u001b[33m\"\u001b[39;49;00m\u001b[33mMedición\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[127.644, "o", "\u001b[90m 203\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Imprime caudal, volumen y batería a partir de un payload de la SWV-NH.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[127.699, "o", "\u001b[90m 204\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[96misinstance\u001b[39;49;00m(payload, \u001b[96mdict\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[127.754, "o", "\u001b[90m 205\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[127.809, "o", "\u001b[90m 206\u001b[0m\u001b[90m │ \u001b[0m    battery = payload.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mbattery\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[127.864, "o", "\u001b[90m 207\u001b[0m\u001b[90m │ \u001b[0m    flow = payload.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mflow\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
