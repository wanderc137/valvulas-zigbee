[140.208, "o", "\u001b[90m┌─ menu_valvulas.py · send_valve_command() ─────────────────────────────────────────────────────────────\u001b[0m\n"]
[140.208, "o", "\u001b[90m  56\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92msend_valve_command\u001b[39;49;00m(mq, alias, new_state):\u001b[90m\u001b[39;49;00m\n"]
[140.263, "o", "\u001b[90m  57\u001b[0m\u001b[90m │ \u001b[0m    \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mEnvía ON/OFF a una válvula y espera confirmación real. Devuelve (ok, mensaje, payload).…\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[140.318, "o", "\u001b[90m  58\u001b[0m\u001b[90m │ \u001b[0m    topic = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mZ2M_PREFIX\u001b[33m}\u001b[39;49;00m\u001b[33m/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mVALVULAS[alias]\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[140.373, "o", "\u001b[90m  59\u001b[0m\u001b[90m │ \u001b[0m    mq.received.pop(topic, \u001b[94mNone\u001b[39;49;00m)  \u001b[90m# descartar estado previo cacheado\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[140.428, "o", "\u001b[90m  60\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[140.483, "o", "\u001b[90m  61\u001b[0m\u001b[90m │ \u001b[0m    \u001b[90m# Despertar la válvula (end device a batería) con un \"get\" antes del comando,\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
